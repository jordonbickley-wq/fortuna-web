# LINE Login (developers.line.biz console -> your channel -> Basic settings)
LINE_LOGIN_CHANNEL_SECRET=REPLACE_ME

# Omise (dashboard.omise.co -> API Keys) - use test keys (pkey_test_/skey_test_) until you're ready to go live
OMISE_PUBLIC_KEY=REPLACE_ME
OMISE_SECRET_KEY=REPLACE_ME

# Random long string used to sign session cookies - generate any long random value
SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

PORT=3000
